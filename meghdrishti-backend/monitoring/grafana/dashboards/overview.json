{
  "title": "MeghDrishti Overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "graph",
      "title": "Observations Ingested / Failed",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(meghdrishti_observations_ingested_total[5m])) by (source)", "legendFormat": "ingested {{source}}"},
        {"expr": "sum(rate(meghdrishti_observations_failed_total[5m])) by (source)", "legendFormat": "failed {{source}}"}
      ]
    },
    {
      "type": "graph",
      "title": "Anomalies by Classification",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(meghdrishti_anomalies_created_total[5m])) by (classification)", "legendFormat": "{{classification}}"}
      ]
    },
    {
      "type": "graph",
      "title": "Alerts Created",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(meghdrishti_alerts_created_total[5m])) by (priority)", "legendFormat": "{{priority}}"}
      ]
    },
    {
      "type": "graph",
      "title": "Station Health Distribution",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "meghdrishti_station_health_distribution", "legendFormat": "{{status}}"}
      ]
    },
    {
      "type": "graph",
      "title": "HTTP Request Duration (p95)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"}
      ]
    },
    {
      "type": "graph",
      "title": "Model Inference / Context Fetch Duration (p95)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(meghdrishti_model_inference_duration_seconds_bucket[5m])) by (le))", "legendFormat": "ml inference"},
        {"expr": "histogram_quantile(0.95, sum(rate(meghdrishti_context_fetch_duration_seconds_bucket[5m])) by (le))", "legendFormat": "context fetch"}
      ]
    },
    {
      "type": "graph",
      "title": "Active WebSocket Connections",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "meghdrishti_websocket_connections", "legendFormat": "{{channel}}"}
      ]
    }
  ]
}
