# --- App ---
APP_NAME=meghdrishti-backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://meghdrishti:meghdrishti@localhost:5432/meghdrishti
DATABASE_URL_SYNC=postgresql+psycopg://meghdrishti:meghdrishti@localhost:5432/meghdrishti

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Demo admin (never commit real credentials) ---
DEMO_ADMIN_EMAIL=admin@meghdrishti.local
DEMO_ADMIN_PASSWORD=change-me-demo-password

# --- Google Sign-In (OAuth2 ID token) ---
# Create at https://console.cloud.google.com/apis/credentials — OAuth client ID,
# type "Web application". No client secret needed (ID token flow only).
GOOGLE_CLIENT_ID=

# --- Ingestion sources ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

IMD_API_BASE_URL=
IMD_API_KEY=
IMD_ENABLED=false

NOAA_ISD_BASE_URL=https://www.ncei.noaa.gov/access/services/data/v1
NOAA_API_TOKEN=

ERA5_CDS_URL=https://cds.climate.copernicus.eu/api
ERA5_CDS_KEY=

NASA_GPM_BASE_URL=https://gpm1.gesdisc.eosdis.nasa.gov
NASA_GPM_TOKEN=

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Observability ---
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true

# --- Airflow (compose) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin
